{
    "name": "alphapay/alphapay-php",
    "description": "Official PHP SDK for the AlphaPay payment aggregator API.",
    "type": "library",
    "license": "MIT",
    "keywords": ["alphapay", "payments", "mobile-money", "payment-gateway", "africa"],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "AlphaPay\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AlphaPay\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "find src -name '*.php' -print0 | xargs -0 -n1 -P4 php -l"
    },
    "minimum-stability": "stable"
}
